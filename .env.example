# ------------------------------------------------------------------
# AI Changing Room — environment variables
# Copy this file to .env.local and adjust as needed.
# The app works out of the box with zero configuration (mock AI).
# ------------------------------------------------------------------

# AI provider to use for virtual try-on generation.
#   mock         -> simulated generation, free, no keys required (default)
#   fal          -> REAL AI: hosted CatVTON model on fal.ai, requires FAL_KEY
#   idmvton      -> REAL AI, FREE: public IDM-VTON Space on Hugging Face
#                   ZeroGPU hardware, no key required (non-commercial license;
#                   queue can be slow and the Space can pause or rate-limit).
#                   Add HUGGINGFACE_TOKEN (free) for a much larger daily quota.
#   huggingface  -> optional real provider, requires HUGGINGFACE_TOKEN
# Future values: replicate | openai | gemini
AI_PROVIDER=mock

# Mock provider simulated latency (ms)
AI_PROVIDER_MOCK_MIN_DELAY_MS=3000
AI_PROVIDER_MOCK_MAX_DELAY_MS=5000

# FAL AI API key (only needed when AI_PROVIDER=fal)
# Get one at https://fal.ai/dashboard/keys after signing up at https://fal.ai
# FAL_KEY=

# IDM-VTON Space base URL (only needed when AI_PROVIDER=idmvton)
# Override if the Space moves or you deploy your own copy.
# IDMVTON_SPACE_URL=https://yisol-idm-vton.hf.space

# Hugging Face API token — REQUIRED for AI_PROVIDER=huggingface; strongly
# recommended for AI_PROVIDER=idmvton (free account, massively bigger ZeroGPU quota).
# Get one at https://huggingface.co/settings/tokens
# HUGGINGFACE_TOKEN=

# ------------------------------------------------------------------
# Database (Neon serverless Postgres — required for persisted catalogs)
# 1. Create a free database at https://neon.tech (or via Vercel Marketplace:
#    Project Settings -> Integrations -> Neon).
# 2. Copy BOTH connection strings from Neon into your .env.local AND into
#    Vercel's Environment Variables (Settings -> Environment Variables):
#      DATABASE_URL  = the pooled connection string (host contains "-pooler")
#      DIRECT_URL    = the direct connection string (used by prisma db push/seed)
# 3. Run:  npm run db:push && npm run db:seed
DATABASE_URL="postgres://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require"
DIRECT_URL="postgres://user:pass@host.region.aws.neon.tech/db?sslmode=require"

# Canonical app URL, used for metadata and share links
NEXT_PUBLIC_APP_URL=http://localhost:3000
